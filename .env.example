# API 기본 경로 — 로컬에서는 Vite 프록시(/api → VITE_API_PROXY_TARGET)를 사용
VITE_API_BASE_URL=/api

# 로컬 백엔드 주소 (Spring 기본 포트 8080)
VITE_API_PROXY_TARGET=http://localhost:8080

# 목 API(MSW) — 개발 서버에서는 기본 켜짐. false 면 실제 백엔드로 요청
# VITE_API_MOCKING=false

# Toss 결제창 클라이언트 키 — 서버의 TOSS_SECRET_KEY 와 짝인 테스트 키만 사용
# 비어 있으면 개발 서버에서 결제창 없이 승인 단계로 넘어감 (로컬 가짜 Toss·목 API 용)
# VITE_TOSS_CLIENT_KEY=

# [임시] 점주 매장 id — 백엔드에 '내 매장 목록' API 가 생기기 전까지 사용 (기본: 실제 백엔드 1, 목 API 2,4)
# VITE_OWNER_STORE_IDS=1
