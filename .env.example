# API 기본 경로 — 로컬에서는 Vite 프록시(/api → VITE_API_PROXY_TARGET)를 사용
VITE_API_BASE_URL=/api

# 로컬 백엔드 주소 (Spring 기본 포트 8080)
VITE_API_PROXY_TARGET=http://localhost:8080

# 목 API(MSW) — 개발 서버에서는 기본 켜짐
#   false   : 실제 백엔드로 요청 (백엔드에 없는 기능은 화면에서 숨김)
#   backend : 목 API 를 쓰되 백엔드에 있는 기능만 노출 (실제 연동 미리보기)
# VITE_API_MOCKING=false

# [임시] 실제 연동 시 점주 매장 id — 백엔드에 '내 매장 목록' API 가 생기기 전까지 사용
# VITE_OWNER_STORE_IDS=1
