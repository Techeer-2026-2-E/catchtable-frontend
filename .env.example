# API 기본 경로 — 로컬에서는 Vite 프록시(/api → VITE_API_PROXY_TARGET)를 사용
VITE_API_BASE_URL=/api

# 로컬 백엔드 주소 (Spring 기본 포트 8080)
VITE_API_PROXY_TARGET=http://localhost:8080

# 목 API(MSW) — 개발 서버에서는 기본 켜짐. false 면 실제 백엔드로 요청
# VITE_API_MOCKING=false

# Toss 결제창 클라이언트 키 — 서버의 TOSS_SECRET_KEY 와 짝인 테스트 키만 사용
# 실제 API 모드에서는 키가 없으면 결제를 시작하지 않음
# VITE_TOSS_CLIENT_KEY=

# 개발 서버 + 로컬 fake PG를 명시적으로 선택할 때만 true. 실제 PG 서버에 연결한 채 사용하지 않음
# MSW 개발 모드는 자동으로 시뮬레이션을 사용하며 배포 빌드에서는 항상 비활성
# VITE_TOSS_SIMULATION=false

# [임시] 점주 매장 id — 백엔드에 '내 매장 목록' API 가 생기기 전까지 사용 (기본: 실제 백엔드 1, 목 API 2,4)
# VITE_OWNER_STORE_IDS=1

# 카카오맵 JavaScript 키 — 지도로 매장 찾기(/map). 비우면 키 없이 그리는 간이 지도로 대신함
# 카카오 개발자 콘솔 > 내 애플리케이션 > 플랫폼 > Web 에 http://localhost:5173 등 도메인 등록 필요
# VITE_KAKAO_MAP_KEY=
